# Voliteľné. Pomáha zvýšiť limity požiadaviek pri vyhľadávaní cez Semantic Scholar.
# Ak kľúč máte, skopírujte tento súbor do .env a doplňte ho za znak rovná sa.
SEMANTIC_SCHOLAR_API_KEY=

# Voliteľné. Používa sa pri webovom vyhľadávaní patentových zdrojov pred záložným vyhľadávaním cez WIPO.
TAVILY_API_KEY=
EXA_API_KEY=

# Voliteľné, ale odporúčané. Používa sa ako hlavný zdroj webového vyhľadávania.
# Server akceptuje aj tieto názvy API kľúča: GOOGLE_CUSTOM_SEARCH_API_KEY,
# CUSTOM_SEARCH_API_KEY alebo GOOGLE_API_KEY.
# Server akceptuje aj tieto názvy identifikátora vyhľadávača: GOOGLE_CSE_CX,
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID, GOOGLE_CUSTOM_SEARCH_CX,
# CUSTOM_SEARCH_ENGINE_ID alebo GOOGLE_CX.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=