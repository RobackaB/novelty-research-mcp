# Optional. Helps raise the request limits when searching through Semantic Scholar.
# If you have a key, copy this file to .env and add the key after the equals sign.
SEMANTIC_SCHOLAR_API_KEY=

# Optional. Used for web search of patent sources before the WIPO fallback search.
TAVILY_API_KEY=
EXA_API_KEY=

# Optional but recommended. Used as the primary web search source.
# The server also accepts these names for the API key: GOOGLE_CUSTOM_SEARCH_API_KEY,
# CUSTOM_SEARCH_API_KEY or GOOGLE_API_KEY.
# It also accepts these names for the search engine identifier: GOOGLE_CSE_CX,
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID, GOOGLE_CUSTOM_SEARCH_CX,
# CUSTOM_SEARCH_ENGINE_ID or GOOGLE_CX.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional. Raises the NCBI E-utilities limits when searching publications through PubMed.
PUBMED_API_KEY=

# Optional. AlphaXiv MCP API key for supplementary publication search through
# their remote MCP server (discover_papers). Create one at
# alphaxiv.org under Settings > API Keys.
ALPHAXIV_API_KEY=

# Optional. Raises the request limit for the free Jina Reader (r.jina.ai),
# which serves as the fallback fetch for web and publication pages.
# A free key can be created at jina.ai.
JINA_API_KEY=

# Optional. Contact e-mail for the Unpaywall API (looking up an open-access PDF
# by DOI). Unpaywall requires a real e-mail address in the request rather than an
# API key; addresses of the form *@example.com are rejected. If left empty, a
# default value is used.
UNPAYWALL_EMAIL=

# Optional. Credentials for the Flowise UI when started through docker compose.
FLOWISE_USERNAME=
FLOWISE_PASSWORD=

# Optional. Network settings for the MCP server; the defaults suit a Docker run.
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*,mcp-research-server:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://host.docker.internal:*,http://mcp-research-server:*

# Optional. Path to the research SQLite database; in Docker it is set by docker-compose.yml.
# RESEARCH_SESSION_DB=

# Optional. Disables the coloured startup banner (MCP_NO_UI=1 hides it entirely).
# NO_COLOR=
# MCP_PLAIN_UI=
# MCP_NO_UI=
