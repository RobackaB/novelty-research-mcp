# Voliteľné. Pomáha zvýšiť limity požiadaviek pri vyhľadávaní cez Semantic Scholar.
# Ak kľúč máte, skopírujte tento súbor do .env a doplňte ho za znak rovná sa.
SEMANTIC_SCHOLAR_API_KEY=

# Voliteľné. Používa sa pri webovom vyhľadávaní patentových zdrojov pred záložným vyhľadávaním cez WIPO.
TAVILY_API_KEY=
EXA_API_KEY=

# Voliteľné, ale odporúčané. Používa sa ako hlavný zdroj webového vyhľadávania.
# Server akceptuje aj tieto názvy API kľúča: GOOGLE_CUSTOM_SEARCH_API_KEY,
# CUSTOM_SEARCH_API_KEY alebo GOOGLE_API_KEY.
# Server akceptuje aj tieto názvy identifikátora vyhľadávača: GOOGLE_CSE_CX,
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID, GOOGLE_CUSTOM_SEARCH_CX,
# CUSTOM_SEARCH_ENGINE_ID alebo GOOGLE_CX.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Voliteľné. Zvyšuje limity NCBI E-utilities pri vyhľadávaní publikácií cez PubMed.
PUBMED_API_KEY=

# Voliteľné. AlphaXiv MCP API kľúč pre doplnkové publikačné vyhľadávanie
# cez ich vzdialený MCP server (discover_papers). Vytvoríte ho na
# alphaxiv.org v Settings > API Keys.
ALPHAXIV_API_KEY=

# Voliteľné. Zvyšuje limit požiadaviek na bezplatný Jina Reader (r.jina.ai),
# ktorý slúži ako záložné načítanie webových a publikačných stránok.
# Bezplatný kľúč si vytvoríte na jina.ai.
JINA_API_KEY=

# Voliteľné. Kontaktný e-mail pre Unpaywall API (vyhľadanie voľne dostupného
# PDF podľa DOI). Unpaywall vyžaduje reálnu e-mailovú adresu v dopyte, nie
# API kľúč; adresy v tvare *@example.com sú odmietnuté. Ak nevyplníte, použije
# sa predvolená hodnota.
UNPAYWALL_EMAIL=

# Voliteľné. Prihlasovacie údaje pre Flowise UI pri spustení cez docker compose.
FLOWISE_USERNAME=
FLOWISE_PASSWORD=

# Voliteľné. Sieťové nastavenia MCP servera; predvolené hodnoty vyhovujú Docker spusteniu.
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_PATH=/mcp
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*,mcp-research-server:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://host.docker.internal:*,http://mcp-research-server:*

# Voliteľné. Cesta k SQLite databáze prieskumov; v Dockeri ju nastavuje docker-compose.yml.
# RESEARCH_SESSION_DB=

# Voliteľné. Vypne farebný startup banner (MCP_NO_UI=1 banner úplne skryje).
# NO_COLOR=
# MCP_PLAIN_UI=
# MCP_NO_UI=
